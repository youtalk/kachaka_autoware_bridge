<?xml version="1.0"?>
<robot name="kachaka_with_shelf" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find kachaka_description)/urdf/_materials.urdf.xacro"/>
  <xacro:include filename="$(find kachaka_description)/urdf/_values.urdf.xacro"/>
  <xacro:include filename="$(find kachaka_description)/urdf/_kachaka.urdf.xacro"/>
  <xacro:include filename="$(find kachaka_autoware_description)/urdf/_shelf_3tier.urdf.xacro"/>
  <xacro:include filename="$(find kachaka_autoware_description)/urdf/_ouster_os1.urdf.xacro"/>

  <!-- with_shelf:=false publishes the bare Kachaka body only (no 3-tier shelf,
       no OS-1). Default true: the robot physically carries the Autoware shelf. -->
  <xacro:arg name="with_shelf" default="true"/>

  <link name="base_footprint"/>

  <xacro:kachaka_robot parent="base_footprint">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:kachaka_robot>

  <xacro:if value="$(arg with_shelf)">
  <!--
    docking_link is Kachaka's docking lift mechanism (prismatic joint).
    The frame itself sits at base_link origin; the solenoid that supports
    the shelf reaches up to z ≈ 0.115 m (cylinder center 0.1075 + half
    length 0.0075). Mount the shelf bottom there so the published TF
    matches the physical sensor pose. The shelf still follows the lift
    (up to +0.012 m) because docking_link is a prismatic child of base_link.
  -->
  <!-- No yaw: the shelf + OS-1 assembly is mounted facing forward, aligned with
       base_link. (An earlier rpy="0 0 PI" yaw flip was a mis-diagnosis made while
       the OS-1 cloud was mis-timestamped and not rendering in the map frame; with
       the cloud correctly displayed it is 180 deg off, so the flip is removed —
       RViz-verified 2026-07-10.) -->
  <xacro:shelf_3tier parent="docking_link">
    <origin xyz="0 0 0.115" rpy="0 0 0"/>
  </xacro:shelf_3tier>

  <!-- Mount the Ouster OS-1 on the bottom shelf board (relocated 2026-07 from
       shelf_top to lower the sensor to ~0.17 m above base_link, enabling ground-filter
       experiments). shelf_bottom_board's link frame sits at the shelf base; origin z is
       one board thickness (0.015) so the sensor body rests on the board's top surface.
       Override origin with the M0-measured mount pose. name="os" so URDF link names
       (os_sensor / os_lidar / os_imu) match the ouster_ros driver's default sensor_frame /
       lidar_frame / imu_frame; otherwise the published cloud's frame_id is unconnected to
       the robot TF tree and downstream NDT / snapshot tools fail to look up the transform. -->
  <xacro:ouster_os1 parent="shelf_bottom_board" name="os">
    <origin xyz="0 0 0.015" rpy="0 0 0"/>
  </xacro:ouster_os1>
  </xacro:if>

</robot>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kachaka_autoware_sensing</name>
  <version>0.0.0</version>
  <description>Sensing adapters for the stock Kachaka + Autoware Core stack. Converts the raw Ouster OS-1 point cloud into Autoware's PointXYZIRC layout so the NDT and ground-filter pipeline can consume it.</description>
  <maintainer email="yutaka.kondo@youtalk.jp">Yutaka Kondo</maintainer>
  <license>Apache License 2.0</license>
  <author email="yutaka.kondo@youtalk.jp">Yutaka Kondo</author>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>autoware_point_types</depend>
  <depend>point_cloud_msg_wrapper</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
